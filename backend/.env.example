# ─────────────────────────────────────────────────────────────────────────────
# WeatherGPT — .env.example
# Copy to .env and fill in your values. Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq LLM (https://console.groq.com) ──────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
MAX_MESSAGE_LENGTH=1000
LLM_MAX_OUTPUT_TOKENS=400

# ── Supabase (https://supabase.com → Project Settings → API) ─────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT Secret from Supabase Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── CORS allowed origins (comma-separated, no trailing slash) ─────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ── Open-Meteo (free, no API key required) ───────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_CLIMATE_URL=https://climate-api.open-meteo.com/v1

# ── Alerts Scheduler ─────────────────────────────────────────────────────────
ALERT_CHECK_INTERVAL_MINUTES=15

# ── Nominatim (free, no API key required) ────────────────────────────────────
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=WeatherGPT/2.0 (sih-weathergpt-backend)

# ── HTTP Timeouts (seconds) ───────────────────────────────────────────────────
WEATHER_API_TIMEOUT=10
LLM_TIMEOUT=30
GEO_TIMEOUT=5

# ── Redis Cloud (Centralized Rate Limiting & User Location Cache) ────────────
# Example: redis://default:<password>@<redis-cloud-host>:<port>
REDIS_URL=

# ── Rate Limiting (Redis-backed per-user, format: count/period) ───────────────
RATE_LIMIT_CHAT=120/minute
RATE_LIMIT_LOCATION=120/minute
RATE_LIMIT_ALERTS=120/minute

# ── Cache TTLs (seconds) ──────────────────────────────────────────────────────
WEATHER_CACHE_TTL=300
FORECAST_CACHE_TTL=600
HOURLY_CACHE_TTL=300
CLIMATE_CACHE_TTL=3600
LOCATION_CACHE_TTL=3600

# ── Resilience (retry & circuit breaker) ───────────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=0.5
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW=60
CIRCUIT_BREAKER_COOLDOWN=30

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=WeatherGPT
APP_VERSION=2.0.0
DEBUG=false
LOG_LEVEL=INFO
