# ─────────────────────────────────────────────────────────────────────────────
# WeatherGPT — .env.example
# Copy to .env and fill in your values. Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq LLM (https://console.groq.com) ──────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ── Supabase (https://supabase.com → Project Settings → API) ─────────────────
# Run the SQL in supabase/schema.sql once in your project's SQL editor.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ── CORS allowed origins (comma-separated, no trailing slash) ─────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Open-Meteo (free, no API key required) ───────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_CLIMATE_URL=https://climate-api.open-meteo.com/v1

# ── Alerts Scheduler ─────────────────────────────────────────────────────────
ALERT_CHECK_INTERVAL_MINUTES=15

# ── Nominatim (free, no API key required) ────────────────────────────────────
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=WeatherGPT/1.0 (sih-weathergpt-backend)

# ── HTTP Timeouts (seconds) ───────────────────────────────────────────────────
WEATHER_API_TIMEOUT=10
LLM_TIMEOUT=30
GEO_TIMEOUT=5

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=WeatherGPT
APP_VERSION=1.0.0
DEBUG=false
